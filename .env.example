# If backend runs in Docker and PostgreSQL runs on your host, use host.docker.internal.
# If backend runs directly on your machine, use localhost.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/whatsapp_platform
JWT_SECRET=supersecretkey_change_in_production
REDIS_HOST=redis
REDIS_PORT=6379
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
