# Backend production environment
NODE_ENV=production
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:change_me@127.0.0.1:5432/whatsapp_platform

# JWT
JWT_SECRET=change_me_to_a_long_random_secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Puppeteer / Chromium on Debian
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional WhatsApp inbound logging
WA_LOG_INBOUND_PAYLOADS=true
WA_LOG_INBOUND_FILE=true
WA_LOG_INBOUND_FILE_NAME=wa-inbound.log
WA_LOG_INBOUND_MAX_LENGTH=20000
